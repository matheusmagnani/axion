generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum ContractStatus {
  ACTIVE
  ENDED
  CANCELLED
  PENDING
}

enum BillingStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ImportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// Models
model Company {
  id          Int      @id @default(autoincrement())
  companyName String   @map("company_name")
  tradeName   String?  @map("trade_name")
  cnpj        String   @unique
  department  String?
  email       String?
  phone       String?
  address       String?
  addressNumber String?  @map("address_number")
  complement    String?
  neighborhood  String?
  city        String?
  state       String?
  zipCode     String?  @map("zip_code")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users      User[]
  roles      Role[]
  associates Associate[]
  contracts  Contract[]
  billings   Billing[]
  products   Product[]
  plans      Plan[]
  importJobs ImportJob[]

  @@map("companies")
}

model Associate {
  id        Int              @id @default(autoincrement())
  name      String
  cpf       String
  email     String
  phone     String
  status    Int              @default(2)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  deletedAt DateTime?        @map("deleted_at")

  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  contracts Contract[]
  billings  Billing[]

  @@unique([cpf, companyId])
  @@map("associates")
}

model Contract {
  id          Int             @id @default(autoincrement())
  number      String          @unique
  description String?
  value       Decimal         @db.Decimal(10, 2)
  startDate   DateTime        @map("start_date")
  endDate     DateTime?       @map("end_date")
  status      ContractStatus  @default(PENDING)

  associateId Int             @map("associate_id")
  associate   Associate       @relation(fields: [associateId], references: [id])

  companyId   Int             @map("company_id")
  company     Company         @relation(fields: [companyId], references: [id])

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  deletedAt   DateTime?       @map("deleted_at")

  billings    Billing[]

  @@map("contracts")
}

model Billing {
  id            Int            @id @default(autoincrement())
  description   String
  value         Decimal        @db.Decimal(10, 2)
  subtotal      Decimal?       @db.Decimal(10, 2)
  dueDate       DateTime       @map("due_date")
  paymentDate   DateTime?      @map("payment_date")
  status        BillingStatus  @default(PENDING)
  type          String?
  origin        String?
  planId        Int?           @map("plan_id")
  productIds    Int[]          @map("product_ids")
  discountType  String?        @map("discount_type")
  discountValue Decimal?       @db.Decimal(10, 2) @map("discount_value")

  associateId   Int            @map("associate_id")
  associate     Associate      @relation(fields: [associateId], references: [id])

  contractId    Int?           @map("contract_id")
  contract      Contract?      @relation(fields: [contractId], references: [id])

  companyId     Int            @map("company_id")
  company       Company        @relation(fields: [companyId], references: [id])

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  deletedAt     DateTime?      @map("deleted_at")

  @@map("billings")
}

model Role {
  id        Int        @id @default(autoincrement())
  name      String
  status    Int        @default(1)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")

  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  users       User[]
  permissions Permission[]

  @@unique([name, companyId])
  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  roleId    Int      @map("role_id")
  module    String
  action    String
  allowed   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, module, action])
  @@map("permissions")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  companyId Int     @map("company_id")
  company   Company @relation(fields: [companyId], references: [id])

  roleId    Int?    @map("role_id")
  role      Role?   @relation(fields: [roleId], references: [id])

  @@map("users")
}

model Product {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  price       Decimal   @db.Decimal(10, 2)
  image       String?
  status      Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  companyId   Int       @map("company_id")
  company     Company   @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
  @@map("products")
}

model Plan {
  id            Int       @id @default(autoincrement())
  name          String
  description   String?
  productIds    Int[]     @map("product_ids")
  discountType  String?   @map("discount_type")
  discountValue Decimal?  @db.Decimal(10, 2) @map("discount_value")
  status        Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  companyId     Int       @map("company_id")
  company       Company   @relation(fields: [companyId], references: [id])

  @@unique([name, companyId])
  @@map("plans")
}

model ImportJob {
  id            Int             @id @default(autoincrement())
  jobId         String          @map("job_id")
  queueName     String          @map("queue_name")
  status        ImportJobStatus @default(PENDING)
  totalRows     Int             @default(0) @map("total_rows")
  successCount  Int             @default(0) @map("success_count")
  errorCount    Int             @default(0) @map("error_count")
  errors        Json?
  successes     Json?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  companyId     Int             @map("company_id")
  company       Company         @relation(fields: [companyId], references: [id])

  userId        Int             @map("user_id")

  @@map("import_jobs")
}
